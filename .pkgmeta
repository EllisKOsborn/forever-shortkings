package-as: ShortKings

enable-nolib-creation: no

# LibStub, CallbackHandler, AceComm, LibSerialize and LibDeflate are committed
# in Libs/. These two are fetched when the release zip is built.
externals:
  Libs/LibDataBroker-1.1: https://github.com/tekkub/libdatabroker-1-1.git
  Libs/LibDBIcon-1.0: https://repos.wowace.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0

ignore:
  - tests
  - PLAN.md
  - TESTING.md
  - .busted
  - .luacheckrc
  - .github
